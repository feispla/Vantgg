# Token del bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=pega_aqui_el_token_del_bot_de_discord

# Opcional: ID de la aplicación/cliente de Discord
DISCORD_CLIENT_ID=

# Opcional: ID del servidor (guild) donde corre el bot
DISCORD_GUILD_ID=

# Secreto compartido para firmar los eventos que el bot envía a la web (HMAC)
VANT_BOT_SYNC_SECRET=

# Base URL del backend/web de VANT que recibe los eventos
VANT_WEB_BASE_URL=https://vantgg.vercel.app/
